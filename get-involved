/* ── Tokens — EXACT from homepage ── */
:root {
  --coral: #EE785A; --coral-dark: #d56b50; --coral-tint: #fef6f4;
  --purple: #5b3578; --navy: #06091e;
  --white: #ffffff; --off-white: #fafaf8;
  --fg: #1a1917; --fg-body: #545454; --fg-muted: #7a7a7a; --fg-subtle: #9a9a9a;
  --fg-on-dark: #ffffff; --fg-on-dark-muted: rgba(255,255,255,0.85);
  --border: rgba(26,25,23,0.1);
  --r-sm:8px; --r-md:14px; --r-lg:20px; --r-xl:28px; --r-pill:100px;
  --shadow-card: 0 1px 4px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,0,0,0.04);
  --shadow-coral: 0 4px 20px rgba(238,120,90,0.3);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Outfit',sans-serif;font-weight:400;font-size:17px;line-height:1.7;color:var(--fg-body);background:var(--white);-webkit-font-smoothing:antialiased;text-wrap:pretty}
h1,h2,h3,h4,h5{font-family:'Urbanist',sans-serif;color:var(--fg);line-height:1.12;text-wrap:balance}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.container{max-width:1100px;margin:0 auto;padding:0 48px}
.section{padding:112px 0}
.eyebrow{font-family:'Urbanist',sans-serif;font-size:15px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--coral)}
.material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;vertical-align:middle}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;gap:8px;font-family:'Urbanist',sans-serif;font-weight:600;border:none;cursor:pointer;transition:all 0.2s;text-decoration:none}
.btn-primary{background:var(--coral);color:#fff;font-size:16px;padding:16px 32px;border-radius:var(--r-pill)}
.btn-primary:hover{background:var(--coral-dark);transform:translateY(-1px);box-shadow:var(--shadow-coral)}
.btn-outline{background:transparent;color:var(--fg);font-size:15px;padding:16px 24px;border:1.5px solid rgba(26,25,23,0.2);border-radius:var(--r-pill);transition:all 0.2s ease}
.btn-outline:hover{background:var(--fg);color:#fff;border-color:var(--fg);transform:translateY(-1px)}
.fade-up{opacity:0;transform:translateY(22px);transition:opacity 0.6s ease,transform 0.6s ease}
.fade-up.visible{opacity:1;transform:translateY(0)}

/* ── Nav ── */
.nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,0.94);backdrop-filter:blur(20px) saturate(1.4);border-bottom:1px solid var(--border);height:64px;padding:0 48px;display:flex;align-items:center;justify-content:space-between}
.nav-logo{display:flex;align-items:center;gap:8px}
.nav-logo svg{height:28px;width:auto}
.nav-logo-text{font-family:'Urbanist',sans-serif;font-size:15px;font-weight:800;letter-spacing:0.06em;color:var(--fg)}
.nav-links{display:flex;list-style:none;gap:36px;align-items:center}
.nav-links a{font-family:'Outfit',sans-serif;font-size:14px;color:var(--fg-muted);transition:color 0.15s}
.nav-links a:hover{color:var(--fg)}
.nav-cta{background:var(--coral);color:#fff !important;padding:9px 22px;border-radius:var(--r-pill);font-family:'Urbanist',sans-serif !important;font-size:13px !important;font-weight:600 !important;transition:background 0.15s,transform 0.15s}
.nav-cta:hover{background:var(--coral-dark);transform:translateY(-1px)}

/* ── Footer ── */
.footer-divider{height:1px;background:rgba(255,255,255,0.08);margin-bottom:32px}
.footer-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
.footer-links{display:flex;gap:24px}
.footer-links a{font-size:12px;color:rgba(255,255,255,0.35);transition:color 0.15s}
.footer-links a:hover{color:rgba(255,255,255,0.6)}

/* ── Page-specific ── */
.investor-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 48px}
.investor-row{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border)}
.investor-info{display:flex;flex-direction:column}
.investor-name{font-family:'Urbanist',sans-serif;font-size:15px;font-weight:700;color:var(--fg)}
.investor-title{font-size:13px;color:var(--fg-muted);margin-top:2px}
.li-btn{width:28px;height:28px;border-radius:6px;background:var(--fg);display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;flex-shrink:0;transition:background 0.15s,transform 0.15s}
.li-btn:hover{background:#0a66c2;transform:scale(1.08)}
.inst-logos{display:flex;flex-wrap:wrap;gap:48px;align-items:center;justify-content:center}
.inst-logos img{height:52px;width:auto;transition:transform 0.2s}
.inst-logos img:hover{transform:scale(1.05)}
.advisor-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.advisor-card{padding:16px 20px;border:1px solid var(--border);border-radius:var(--r-md);background:#fff;transition:border-color 0.15s}
.advisor-card:hover{border-color:var(--coral)}
.advisor-name a{color:var(--fg);transition:color 0.15s;text-decoration:none}
.advisor-name a:hover{color:var(--coral)}
.advisor-name{font-family:'Urbanist',sans-serif;font-size:14px;font-weight:700;color:var(--fg)}
.advisor-title{font-size:13px;color:var(--fg-muted);margin-top:2px;line-height:1.45}
.reason-card{display:flex;align-items:flex-start;gap:16px}
.reason-icon{flex-shrink:0;margin-top:2px}

/* ── Form placeholders ── */
input::placeholder,textarea::placeholder{color:var(--fg-subtle) !important}

@media(max-width:768px){
  .container{padding:0 20px}
  .section{padding:72px 0}
  .nav{padding:0 16px}
  .nav-links{display:none}
  .investor-grid{grid-template-columns:1fr}
  .advisor-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){
  .advisor-grid{grid-template-columns:1fr}
}
</style>
